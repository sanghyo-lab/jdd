# Local development only. scripts/dev setup generates separate random passwords.
COMPOSE_PROJECT_NAME=jdd
POSTGRES_DB=jdd
POSTGRES_USER=jdd_admin
POSTGRES_PASSWORD=replace-by-setup
COMMERCE_DB_PASSWORD=replace-by-setup
AGENT_DB_PASSWORD=replace-by-setup
VOC_DB_PASSWORD=replace-by-setup
EVIDENCE_DB_PASSWORD=replace-by-setup
POSTGRES_PORT=5432
COMMERCE_PORT=8080
# Local synthetic concurrency reproduction only; never proxy /internal/reproduction through web.
COMMERCE_REPRODUCTION_ENABLED=false
AGENT_PORT=8081
JDD_AGENT_QUEUE_CAPACITY=20
VOC_PORT=8082
# Ordinary Compose is explicit offline test/mock; it does not interpolate these into Agent.
# Export local settings before scripts/llm login/run-local/demo/smoke-local.
APP_RUNTIME=test
LLM_PROVIDER=mock
CODEX_MODEL=replace-with-workspace-model
CODEX_AUTH_FILE=/absolute/path/outside/repository/jdd-codex/auth.json
# Deployment secret only. Never used or forwarded by the local adapter/override.
OPENAI_MODEL=replace-with-approved-api-model
OPENAI_API_KEY=replace-in-deployment-secret-store
JDD_API_PROFILE_FILE=/absolute/path/to/deployment-budget-profile.json
